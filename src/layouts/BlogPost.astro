---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Giscus from '../components/Giscus.astro';
import CopyCode from '../components/CopyCode.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main.post-main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 2.5rem 1rem 4rem 1rem;
				box-sizing: border-box;
			}

			/* 核心：正文容器严格保持 Astro 官方默认 720px 水平正中央 */
			.post-center-container {
				position: relative;
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
			}

			.article-content {
				width: 100%;
			}

			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}

			.title {
				margin-bottom: 2rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--border-color);
			}

			.title h1 {
				margin: 0 0 0.5rem 0;
				font-size: 2.2rem;
				line-height: 1.25;
			}

			.date {
				margin-bottom: 0.6rem;
				font-size: 0.95rem;
				color: rgb(var(--gray));
			}

			.last-updated-on {
				font-style: italic;
				margin-top: 0.25rem;
			}

			.prose {
				width: 100%;
				color: rgb(var(--gray-dark));
			}

			/* 窄屏/移动端顶部的折叠导航（大屏留白足够时隐藏） */
			.mobile-toc-container {
				display: block;
			}

			/* 桌面端外挂在 720px 正文右侧留白区域，绝对不挤压正文居中 */
			.desktop-toc-outer {
				display: none;
			}

			/* 宽屏留白充足时（>= 1240px），开启右侧悬浮，且正文保持在视口正中 */
			@media (min-width: 1240px) {
				.mobile-toc-container {
					display: none;
				}

				.desktop-toc-outer {
					display: block;
					position: absolute;
					left: calc(100% + 2.5rem);
					top: 0;
					width: 220px;
					height: 100%;
					pointer-events: none;
				}

				.desktop-toc-sticky {
					position: sticky;
					top: 84px;
					max-height: calc(100vh - 110px);
					overflow-y: auto;
					pointer-events: auto;
				}
			}

			@media (max-width: 768px) {
				main.post-main {
					padding: 1.5rem 0.5rem 3rem 0.5rem;
				}

				.title h1 {
					font-size: 1.8rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="post-main">
			<div class="post-center-container">
				<article class="article-content">
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>

					{/* 窄屏或留白不足时展示的折叠导航 */}
					<div class="mobile-toc-container">
						<TableOfContents headings={headings} view="mobile" />
					</div>

					<div class="prose">
						<slot />
					</div>

					<Giscus />
				</article>

				{/* 宽屏外挂在右侧留白处的悬浮目录树 */}
				<aside class="desktop-toc-outer" aria-label="文章导航">
					<div class="desktop-toc-sticky">
						<TableOfContents headings={headings} view="desktop" />
					</div>
				</aside>
			</div>
		</main>
		<Footer />
		<CopyCode />
	</body>
</html>

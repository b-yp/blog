---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Giscus from '../components/Giscus.astro';
import CopyCode from '../components/CopyCode.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main.post-main {
				width: 100%;
				max-width: 1140px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 4rem 1.5rem;
				box-sizing: border-box;
			}

			.post-layout {
				display: flex;
				justify-content: center;
				align-items: flex-start;
				gap: 3rem;
				width: 100%;
			}

			/* 正文区域宽幅舒展 */
			.article-content {
				flex: 1;
				max-width: 820px;
				width: 100%;
				min-width: 0; /* 核心：防止 pre 代码块横向撑破 flex 布局 */
			}

			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}

			.title {
				margin-bottom: 2rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--border-color);
			}

			.title h1 {
				margin: 0 0 0.5rem 0;
				font-size: 2.25rem;
				line-height: 1.25;
			}

			.date {
				margin-bottom: 0.6rem;
				font-size: 0.95rem;
				color: rgb(var(--gray));
			}

			.last-updated-on {
				font-style: italic;
				margin-top: 0.25rem;
			}

			/* 移动端目录容器（大屏隐藏） */
			.mobile-toc-container {
				display: block;
			}

			/* 桌面端外挂悬浮侧栏容器（大屏显示） */
			.desktop-toc-container {
				display: none;
			}

			/* 大屏适配（>= 1140px） */
			@media (min-width: 1140px) {
				.mobile-toc-container {
					display: none;
				}

				.desktop-toc-container {
					display: block;
					width: 230px;
					flex-shrink: 0;
					position: sticky;
					top: 84px;
					max-height: calc(100vh - 110px);
					overflow-y: auto;
				}
			}

			@media (max-width: 768px) {
				main.post-main {
					padding: 1.5rem 1rem 3rem 1rem;
				}

				.title h1 {
					font-size: 1.85rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="post-main">
			<div class="post-layout">
				<article class="article-content">
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>

					{/* 移动端/小屏幕下的顶部折叠目录 */}
					<div class="mobile-toc-container">
						<TableOfContents headings={headings} view="mobile" />
					</div>

					<div class="prose">
						<slot />
					</div>

					<Giscus />
				</article>

				{/* 桌面端独立悬浮侧栏 */}
				<aside class="desktop-toc-container" aria-label="文章侧边栏">
					<TableOfContents headings={headings} view="desktop" />
				</aside>
			</div>
		</main>
		<Footer />
		<CopyCode />
	</body>
</html>

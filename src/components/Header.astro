---
import { EMAIL_URL, GITHUB_URL, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="actions">
			<div class="social-links">
				<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" title="GitHub">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
						<path d="M9 18c-4.51 2-5-2-7-2"></path>
					</svg>
				</a>
				<a href={EMAIL_URL} title="Email">
					<span class="sr-only">Email</span>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="16" x="2" y="4" rx="2"></rect>
						<path d="m22 7-8.99 5.73a2 2 0 0 1-2.02 0L2 7"></path>
					</svg>
				</a>
				<a href="/rss.xml" target="_blank" rel="noopener noreferrer" title="RSS Feed">
					<span class="sr-only">RSS Feed</span>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 11a9 9 0 0 1 9 9"></path>
						<path d="M4 4a16 16 0 0 1 16 16"></path>
						<circle cx="5" cy="19" r="1"></circle>
					</svg>
				</a>
			</div>
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		margin: 0;
		padding: 0 1.25em;
		background: var(--bg-header);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border-color);
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}
	h2 {
		margin: 0;
		font-size: 1.15em;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	nav {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	nav a {
		padding: 0.5em 0.75em;
		color: rgb(var(--gray-dark));
		border-radius: 6px;
		text-decoration: none;
		font-size: 0.95em;
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	nav a:hover {
		color: var(--accent);
		background-color: var(--code-bg);
	}
	nav a.active {
		color: var(--accent);
		font-weight: 600;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.2em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.2em;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		color: rgb(var(--gray-dark));
		border-radius: 6px;
	}
	.social-links a:hover {
		color: var(--accent);
		background-color: var(--code-bg);
	}
	.social-links svg {
		display: block;
	}
	@media (max-width: 640px) {
		.social-links {
			display: none;
		}
	}
</style>

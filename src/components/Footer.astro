---
import { EMAIL_URL, GITHUB_URL, SITE_AUTHOR } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="copyright">
			&copy; {today.getFullYear()} {SITE_AUTHOR}. All rights reserved.
		</div>
		<div class="social-links">
			<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" title="GitHub">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
					<path d="M9 18c-4.51 2-5-2-7-2"></path>
				</svg>
			</a>
			<a href={EMAIL_URL} title="Email">
				<span class="sr-only">Email</span>
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect width="20" height="16" x="2" y="4" rx="2"></rect>
					<path d="m22 7-8.99 5.73a2 2 0 0 1-2.02 0L2 7"></path>
				</svg>
			</a>
			<a href="/rss.xml" target="_blank" rel="noopener noreferrer" title="RSS Feed">
				<span class="sr-only">RSS Feed</span>
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		margin-top: auto;
		padding: 1.5rem 1.25rem 2rem 1.25rem;
		border-top: 1px solid var(--border-color);
		color: rgb(var(--gray));
		font-size: 0.85rem;
		transition: border-color 0.25s ease;
		box-sizing: border-box;
	}

	.footer-inner {
		width: 100%;
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.copyright {
		color: rgb(var(--gray));
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		color: rgb(var(--gray));
		text-decoration: none;
		border-radius: 4px;
		transition: color 0.15s ease, background-color 0.15s ease;
	}

	.social-links a:hover {
		color: var(--accent);
		background-color: var(--code-bg);
	}

	.social-links svg {
		display: block;
	}

	@media (max-width: 600px) {
		.footer-inner {
			flex-direction: column;
			justify-content: center;
			text-align: center;
			gap: 0.6rem;
		}
	}
</style>
